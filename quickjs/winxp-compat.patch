+#if defined(QJS_WINXP_COMPAT)
+/* Condition variables for Windows XP, which has none.
+
+   This is the semaphore + waiters-count construction (Schmidt/pthreads-win32): waiters
+   register, block on a counting semaphore, and a broadcast releases exactly the number
+   registered. The last waiter of a broadcast sets waiters_done so the broadcaster knows every
+   waiter has left, which is what stops a later wait from consuming a stale semaphore token.
+   Only CreateSemaphore, CreateEvent and CRITICAL_SECTION are used, all NT 3.1/4 era. */
+
+static inline void js_cond_init(js_cond_t *cond) {
+    cond->waiters_count = 0;
+    cond->was_broadcast = 0;
+    cond->sema = CreateSemaphore(NULL, 0, 0x7fffffff, NULL);
+    cond->waiters_done = CreateEvent(NULL, FALSE, FALSE, NULL);
+    InitializeCriticalSection(&cond->lock);
+    if (!cond->sema || !cond->waiters_done)
+        abort();
+}
+
+static inline void js_cond_destroy(js_cond_t *cond) {
+    CloseHandle(cond->sema);
+    CloseHandle(cond->waiters_done);
+    DeleteCriticalSection(&cond->lock);
+}
+
+static inline void js_cond_signal(js_cond_t *cond) {
+    int have_waiters;
+    EnterCriticalSection(&cond->lock);
+    have_waiters = cond->waiters_count > 0;
+    LeaveCriticalSection(&cond->lock);
+    if (have_waiters)
+        ReleaseSemaphore(cond->sema, 1, NULL);
+}
+
+static inline void js_cond_broadcast(js_cond_t *cond) {
+    int have_waiters;
+    EnterCriticalSection(&cond->lock);
+    have_waiters = cond->waiters_count > 0;
+    if (have_waiters) {
+        cond->was_broadcast = 1;
+        ReleaseSemaphore(cond->sema, cond->waiters_count, NULL);
+        LeaveCriticalSection(&cond->lock);
+        /* Wait until every released waiter has actually woken, otherwise a token could
+           survive the broadcast and let a future wait return without being signalled. */
+        WaitForSingleObject(cond->waiters_done, INFINITE);
+        cond->was_broadcast = 0;
+    } else {
+        LeaveCriticalSection(&cond->lock);
+    }
+}
+
+static inline int js__cond_wait_for(js_cond_t *cond, js_mutex_t *mutex, DWORD ms) {
+    DWORD rc;
+    int last_waiter;
+
+    EnterCriticalSection(&cond->lock);
+    cond->waiters_count++;
+    LeaveCriticalSection(&cond->lock);
+
+    /* Releasing the caller's mutex and blocking is not atomic here, but a signal that
+       arrives in the gap is still counted: this waiter is already registered, so the
+       semaphore token it releases is waiting when WaitForSingleObject runs. */
+    LeaveCriticalSection(mutex);
+    rc = WaitForSingleObject(cond->sema, ms);
+
+    EnterCriticalSection(&cond->lock);
+    cond->waiters_count--;
+    last_waiter = cond->was_broadcast && cond->waiters_count == 0;
+    LeaveCriticalSection(&cond->lock);
+
+    if (last_waiter)
+        SetEvent(cond->waiters_done);
+
+    EnterCriticalSection(mutex);
+
+    if (rc == WAIT_OBJECT_0)
+        return 0;
+    if (rc == WAIT_TIMEOUT)
+        return -1;
+    abort();
+}
+
+static inline void js_cond_wait(js_cond_t *cond, js_mutex_t *mutex) {
+    if (js__cond_wait_for(cond, mutex, INFINITE) != 0)
+        abort();
+}
+#else
 static inline void js_cond_init(js_cond_t *cond) {
     InitializeConditionVariable(cond);
 }
@@ -1773,13 +1889,18 @@ static inline void js_cond_wait(js_cond_t *cond, js_mutex_t *mutex) {
     if (!SleepConditionVariableCS(cond, mutex, INFINITE))
         abort();
 }
+#endif
 
 static inline int js_cond_timedwait(js_cond_t *cond, js_mutex_t *mutex, uint64_t timeout) {
+#if defined(QJS_WINXP_COMPAT)
+    return js__cond_wait_for(cond, mutex, (DWORD)(timeout / 1e6));
+#else
     if (SleepConditionVariableCS(cond, mutex, (DWORD)(timeout / 1e6)))
         return 0;
     if (GetLastError() != ERROR_TIMEOUT)
         abort();
     return -1;
+#endif
 }
 
