{
  // An import map, npm and jsr packages and a local prefix, the way real Deno projects declare them.
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.0/colors",
    "zod": "npm:zod@3.23.8",
    "lib/": "./lib/"
  },
  "compilerOptions": { "strict": true },
}
