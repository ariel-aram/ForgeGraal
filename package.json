{
  "name": "forgegraal",
  "version": "1.0.0",
  "description": "ForgeScript extension and CLI that turns ForgeScript bots into standalone executables, including 32-bit (iSH, x86, ARMv7) and legacy Windows (7 / Vista) targets",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "forgegraal": "dist/cli.js"
  },
  "files": [
    "dist",
    "metadata",
    "README.md",
    "tools"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "biome check src test",
    "format": "biome format --write src test",
    "docgen": "tsc && node dist/docgen.js",
    "test": "tsc && node --test \"test/**/*.test.ts\"",
    "conformance": "node tools/engine-conformance.js"
  },
  "keywords": [
    "forgescript",
    "graal",
    "binary",
    "sea",
    "ish",
    "windows7",
    "32bit"
  ],
  "author": "Ariel Aram",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "abort-controller": "^3.0.0",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "event-target-shim": "^6.0.2",
    "formdata-node": "^4.4.1",
    "postject": "1.0.0-alpha.6",
    "web-streams-polyfill": "^3.3.3"
  },
  "peerDependencies": {
    "@tryforge/forgescript": "^2.7.1"
  },
  "peerDependenciesMeta": {
    "@tryforge/forgescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tryforge/forgescript": "^2.7.1",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
